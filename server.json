{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "ai.klype/klype",
  "title": "Klype AI",
  "description": "Voice and context layer: draft, check and approve posts in a real person's measured voice.",
  "version": "1.0.1",
  "websiteUrl": "https://klype.ai",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.klype.ai/api/v1/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "klype-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KLYPE_API_KEY",
          "description": "Klype API key (klp_live_...) from app.klype.ai/dashboard/connections",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
